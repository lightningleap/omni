# Copy to .env and fill in. Never commit .env — it is gitignored and excluded
# from Docker images (.dockerignore).

# --- DATABASE (Supabase Postgres) ---
# DATABASE_URL goes through the pooler (used by the app at runtime).
# DIRECT_URL bypasses it (used by Prisma migrations and CLI scripts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Throwaway local Postgres used only by `prisma migrate dev` / `migrate diff`.
# Never point this at production — Prisma resets whatever it names.
SHADOW_DATABASE_URL="postgresql://postgres:shadow@localhost:5433/shadow"

# --- SUPABASE (auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Also used for admin image uploads, which write to the `merch` storage bucket
# (public-read, admin-write). Create it under Supabase -> Storage if it is
# missing; the upload action names it in the error when it is.
SUPABASE_SERVICE_ROLE_KEY=

# --- ADMIN ACCESS ---
# Admins are managed in the admin panel (Customers -> Role), stored in the
# database. This list is only the break-glass override: these emails are admins
# no matter what the database says, so access can never be lost entirely.
# Keep it to one or two people. See src/lib/admin.ts.
ADMIN_EMAILS=owner@yourbrand.com
# Legacy single-admin variable, still honoured. ADMIN_EMAILS wins when both set.
MASTER_ADMIN_EMAIL=owner@yourbrand.com
# Only read by `npm run db:admin` when seeding the first admin row.
SEED_ADMIN_PASSWORD=

# --- PRINTIFY ---
PRINTIFY_API_TOKEN=
# Store that products are created in and orders are routed to
PRINTIFY_SHOP_ID=
# Every store the storefront pulls products FROM (comma-separated)
PRINTIFY_SHOP_IDS=
# Which of those stores stock the children's range. A newly synced product
# inherits ADULT or KIDS from the store it came out of; without this, every
# product defaults to ADULT and kids' items appear in the Adult listings.
PRINTIFY_KIDS_SHOP_IDS=

# --- STRIPE ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- APP ---
AUTH_SECRET=
# Self-hosting only (docker compose): the public hostname Caddy serves and
# requests a TLS certificate for. Must resolve to the server before `up`.
SITE_DOMAIN=yourbrand.com
# Baked into the client bundle at BUILD time — set the real domain before
# building for production, not after.
NEXT_PUBLIC_APP_URL=https://yourbrand.com

# --- ANALYTICS ---
NEXT_PUBLIC_GA_ID=
GA_API_SECRET=

# --- EMAIL (Resend) ---
RESEND_API_KEY=
# Must be a domain verified in Resend; onboarding@resend.dev works for testing.
EMAIL_FROM="BRAND <orders@yourbrand.com>"
# Contact-form destination. Falls back to the first ADMIN_EMAILS entry.
CONTACT_INBOX=
# Optional: overrides the recipient of scripts/send-all-samples.ts
SAMPLE_EMAIL_TO=
